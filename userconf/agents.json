{
  "build": {
    "disable": true
  },
  "plan": {
    "disable": true
  },
  "GPT": {
    "description": "GPT 5.6 Sol coding agent with outcome-first prompting",
    "mode": "primary",
    "model": "openai/gpt-5.6-sol",
    "prompt": "{file:./prompts/gpt-coding.txt}",
    "color": "#10a37f",
    "permission": {
      "start_plan_runner": "allow",
      "get_plan_runner_status": "allow"
    }
  },
  "GPT-Pro": {
    "description": "GPT 5.6 Pro coding agent with maximum reasoning effort",
    "mode": "primary",
    "model": "openai/gpt-5.6-sol-pro",
    "variant": "xhigh",
    "prompt": "{file:./prompts/gpt-coding.txt}",
    "color": "#0d8f70",
    "permission": {
      "start_plan_runner": "allow",
      "get_plan_runner_status": "allow"
    }
  },
  "qwen": {
    "description": "Qwen 3.7 Max optimized coding agent with QwenCode-style prompting",
    "mode": "primary",
    "model": "openai-idealab/Qwen3.7-Max-DogFooding",
    "prompt": "{file:./prompts/qwen37.txt}",
    "temperature": 0.6,
    "color": "#6366f1",
    "permission": {
      "start_plan_runner": "allow",
      "get_plan_runner_status": "allow"
    }
  },
  "claude": {
    "description": "Claude Opus 4.6 coding agent with built-in Anthropic template",
    "mode": "primary",
    "model": "anthropic-idealab/claude-opus-4-6-1m",
    "color": "#d97706",
    "permission": {
      "start_plan_runner": "allow",
      "get_plan_runner_status": "allow"
    }
  },
  "executor": {
    "description": "Deterministic code executor. Temperature 0, low divergence, precise tool calls, minimal-diff edits. Not for exploration or brainstorming.",
    "mode": "subagent",
    "model": "openai/gpt-5.6-terra",
    "variant": "none",
    "temperature": 0,
    "permission": {
      "skill": {
        "*": "allow",
        "external-llm-review": "deny",
        "writing-plans": "deny",
        "verification-before-completion": "deny",
        "plan-runner-dispatch": "deny",
        "workflow-usage": "deny",
        "receiving-code-review": "deny"
      }
    }
  }
}
